{
  "name": "llm-hentaiverse-helper",
  "version": "1.0.0",
  "description": "enable llm to play hentaiverse game",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "webpack --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:browser": "npm run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/HonmaMeikodesu/llm-hentaiverse-helper.git"
  },
  "keywords": [
    "hentaiverse",
    "llm"
  ],
  "author": "HonmaMeikodesu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HonmaMeikodesu/llm-hentaiverse-helper/issues"
  },
  "homepage": "https://github.com/HonmaMeikodesu/llm-hentaiverse-helper#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.299",
    "@types/lodash": "^4.17.14",
    "@types/node": "^26.6.5",
    "babel-loader": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.96.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "fastest-levenshtein": "^1.0.16",
    "linkedom": "^0.18.6",
    "lodash": "^4.17.21",
    "openai": "^4.78.1",
    "prettier": "^3.5.0"
  }
}
